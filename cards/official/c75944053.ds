card "Deskbot 003" {
    id: 75944053
    type: Effect Monster
    attribute: EARTH
    race: Machine
    level: 3
    atk: 500
    def: 500

    effect "Effect 1" {
        speed: 1
        timing: when
        trigger: summoned
        resolve {
            special_summon (1, card, you control, from deck)
        }
    }

    effect "Effect 2" {
        speed: 2
        once_per_turn: soft
        target (1, card, you control, from monster_zone, where is_face_up and archetype == "Deskbot")
        resolve {
            modify_atk target + count((all, card, you control, from field, where is_face_up and archetype == "Deskbot")) * 500 until end_of_turn
            modify_def target + count((all, card, you control, from field, where is_face_up and archetype == "Deskbot")) * 500 until end_of_turn
        }
    }
}
