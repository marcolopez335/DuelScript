card "Laval Forest Sprite" {
    id: 15169262
    type: Effect Monster | Tuner
    attribute: FIRE
    race: Pyro
    level: 2
    atk: 300
    def: 200

    effect "Effect 1" {
        speed: 1
        mandatory
        trigger: custom "chain_end"
        condition: previous_location == field
        resolve {
            modify_atk (all, card, you control, from monster_zone, where is_face_up and archetype == "Laval") + count((all, card, you control, from gy, where archetype == "Laval")) * 200 until end_of_turn
        }
    }
}
