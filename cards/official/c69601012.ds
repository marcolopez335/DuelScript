card "Berfomet the Mythical King of Phantom Beasts" {
    id: 69601012
    type: Fusion Monster
    attribute: WIND
    race: Fiend
    level: 6
    atk: 2400
    def: 600

    summon {
        cannot_normal_summon
        special_summon_procedure {
            from: extra_deck
            to: your_field
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: summoned by special
        resolve {
            send (1, card, you control, from deck, where race == Beast or race == Fiend or race == Illusion) to gy
        }
    }

    effect "Effect 3" {
        speed: 2
        once_per_turn: soft
        cost {
            banish self
        }
        target (1, card, you control, from banished, where (race == Beast or race == Fiend or race == Illusion) and is_face_up)
        resolve {
            special_summon target
        }
    }
}
