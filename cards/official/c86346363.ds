card "Time Reloader" {
    id: 86346363
    type: Effect Monster
    attribute: LIGHT
    race: Machine
    level: 8
    atk: 1200
    def: 2400

    summon {
        tributes: 2
    }

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: custom "chain_active"
        resolve {
            special_summon self
            change_position (1, card, either controls, from monster_zone) to face_down_defense
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: soft
        timing: if
        trigger: custom "chain_active"
        target (1, card, you control, from gy)
        resolve {
            special_summon target in defense_position
            change_position (1, card, either controls, from monster_zone) to face_down_defense
        }
    }
}
