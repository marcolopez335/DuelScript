card "Fabled Realm's Revival" {
    id: 57775790
    type: Continuous Spell

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        mandatory
        resolve {
            set (1, card, you control, from deck, where archetype == "Fabled" and (is_spell or is_trap) and not name == "Fabled Realm's Revival")
        }
    }

    effect "Effect 4" {
        speed: 1
        once_per_turn: soft
        mandatory
        resolve {
            draw 1
            special_summon (all, card, either controls)
        }
    }
}
