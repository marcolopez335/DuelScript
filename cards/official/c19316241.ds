card "Galaxy War Drake" {
    id: 19316241
    type: Effect Monster
    attribute: LIGHT
    race: Dragon
    level: 4
    atk: 1500
    def: 1000

    passive "Effect 3" {
        scope: self
        grant: cannot_attack
    }

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: summoned by special
        resolve {
            special_summon (all, card, either controls)
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: soft
        mandatory
        target (1, card, you control, from monster_zone, except self, where level == 4 and attribute == LIGHT and is_face_up)
        resolve {
            set_level self 8 until end_of_turn
            set_level target 8 until end_of_turn
        }
    }
}
