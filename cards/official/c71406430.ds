card "Libromancer Doombroker" {
    id: 71406430
    type: Ritual Monster
    attribute: DARK
    race: Fiend
    level: 6
    atk: 2500
    def: 2000

    summon {
        cannot_normal_summon
    }

    passive "Effect 2" {
        scope: self
        grant: direct_attack
    }

    effect "Effect 3" {
        speed: 1
        once_per_turn: hard
        mandatory
        resolve {
            set (1, card, you control, from deck, where archetype == "Libromancer" and is_trap)
        }
    }

    effect "Effect 4" {
        speed: 1
        once_per_turn: soft
        timing: when
        trigger: destroyed_by_battle
        target (1, card, opponent controls, from monster_zone, where is_face_up)
        resolve {
            send target to deck
        }
    }
}
