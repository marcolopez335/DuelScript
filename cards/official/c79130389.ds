card "Marincess Coral Anemone" {
    id: 79130389
    type: Link Monster
    attribute: WATER
    race: Cyberse
    link: 2
    link_arrows: [left, bottom]
    atk: 2000

    summon {
        cannot_normal_summon
        link materials: (2, monster, where attribute == WATER)
    }

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        mandatory
        target (1, card, you control, from gy, where attribute == WATER and atk <= 1500)
        resolve {
            special_summon target
            restrict you cannot_special_summon except (attribute == WATER) end_of_turn
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: soft
        timing: if
        trigger: custom "chain_end"
        condition: previous_location == field
        target (1, card, you control, from gy, where archetype == "Marincess" and not name == "Marincess Coral Anemone")
        resolve {
            add_to_hand target
        }
    }
}
