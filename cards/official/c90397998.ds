card "The Six Samurai - Kamon" {
    id: 90397998
    type: Effect Monster
    attribute: FIRE
    race: Warrior
    level: 3
    atk: 1500
    def: 1000

    effect "Effect 1" {
        speed: 1
        once_per_turn: soft
        mandatory
        target (1, card, either controls, from field, where is_face_up and (is_spell or is_trap))
        resolve {
            destroy target
        }
    }

    replacement "Effect 2" {
        instead_of: destroyed
        do {
            banish self
        }
    }
}
