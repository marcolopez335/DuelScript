card "Doodle Beast - Stego" {
    id: 31230289
    type: Effect Monster
    attribute: EARTH
    race: Dinosaur
    level: 5
    atk: 1200
    def: 1800

    summon {
        tributes: 1
    }

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        mandatory
        resolve {
            special_summon self
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: soft
        timing: if
        trigger: summoned
        resolve {
            add_to_hand (1, card, you control, from deck, where archetype == "Doodlebook" and (is_spell or is_trap))
            shuffle_hand yours
            discard (1, card, you control, from hand)
        }
    }

    effect "Effect 3" {
        speed: 1
        once_per_turn: soft
        timing: if
        trigger: summoned by special
        resolve {
            add_to_hand (1, card, you control, from deck, where archetype == "Doodlebook" and (is_spell or is_trap))
            shuffle_hand yours
            discard (1, card, you control, from hand)
        }
    }
}
