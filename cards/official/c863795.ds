card "Galaxy Summoner" {
    id: 863795
    type: Effect Monster
    attribute: LIGHT
    race: Spellcaster
    level: 4
    atk: 1600
    def: 1400

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: summoned
        resolve {
            special_summon (all, card, either controls)
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: summoned by special
        resolve {
            special_summon (all, card, either controls)
        }
    }

    effect "Effect 3" {
        speed: 1
        once_per_turn: soft
        mandatory
        target (1, card, you control, from monster_zone, except self, where is_face_up and attribute == LIGHT and is_monster and not is_xyz and not is_link and not level == 4)
        resolve {
            set_level target 4 until end_of_turn
        }
    }
}
