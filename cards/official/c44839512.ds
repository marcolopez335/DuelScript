card "Conduction Warrior Linear Magnum Plus Minus" {
    id: 44839512
    type: Effect Monster | Effect Monster
    attribute: EARTH
    race: Rock
    level: 7
    atk: 2700
    def: 1300

    summon {
        cannot_normal_summon
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: soft
        mandatory
        target (1, card, either controls, from monster_zone, except self, where attribute == EARTH and is_face_up and atk > 0)
        resolve {
            modify_atk self + target.atk / 2 until end_of_turn
        }
    }

    effect "Effect 3" {
        speed: 1
        once_per_turn: soft
        mandatory
        trigger: custom "chain_end"
        resolve {
            add_to_hand self
        }
    }
}
