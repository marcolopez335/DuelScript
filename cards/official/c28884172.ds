card "Gagaga Mancer" {
    id: 28884172
    type: Effect Monster
    attribute: DARK
    race: Spellcaster
    level: 4
    atk: 100
    def: 100

    effect "Effect 1" {
        speed: 1
        once_per_turn: soft
        mandatory
        target (1, card, you control, from gy, where archetype == "Gagaga" and not name == "Gagaga Mancer")
        resolve {
            special_summon target
            restrict you cannot_special_summon except (archetype == "Gagaga") end_of_turn
        }
    }

    effect "Effect 2" {
        speed: 1
        timing: if
        trigger: custom "chain_end"
        target (1, card, you control, from monster_zone, where is_face_up and is_xyz)
        resolve {
            modify_atk target + 500 until end_of_turn
        }
    }
}
