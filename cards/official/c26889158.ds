card "Salamangreat Gazelle" {
    id: 26889158
    type: Effect Monster
    attribute: FIRE
    race: Cyberse
    level: 3
    atk: 1500
    def: 1000

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: custom "chain_end"
        resolve {
            special_summon self
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: soft
        timing: if
        trigger: summoned
        resolve {
            send (1, card, you control, from deck, where archetype == "Salamangreat" and not name == "Salamangreat Gazelle") to gy
        }
    }

    effect "Effect 3" {
        speed: 1
        once_per_turn: soft
        timing: if
        trigger: summoned by special
        resolve {
            send (1, card, you control, from deck, where archetype == "Salamangreat" and not name == "Salamangreat Gazelle") to gy
        }
    }
}
