card "Water Dragon Cluster" {
    id: 6022371
    type: Effect Monster | Effect Monster
    attribute: WATER
    race: Sea Serpent
    level: 10
    atk: 2800
    def: 2600

    summon {
        cannot_normal_summon
    }

    effect "Effect 2" {
        speed: 1
        timing: if
        trigger: summoned by special
        resolve {
            set_atk (all, card, opponent controls, from monster_zone, where is_face_up and is_effect) 0 until end_of_turn
            grant (all, card, opponent controls, from monster_zone, where is_face_up and is_effect) cannot_activate effects until end_of_turn
        }
    }

    effect "Effect 3" {
        speed: 2
        cost {
            tribute self
        }
        resolve {
            special_summon (all, card, either controls)
        }
    }
}
