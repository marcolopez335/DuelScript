        resolve {
            add_to_hand (1, card, you control, from extra_deck, where is_face_up and archetype == "Zefra" and is_pendulum and not name == "Ritual Beast Tamer Zefrawendi")
        }
    }

    effect "Effect 3" {
        speed: 1
        timing: when
        trigger: summoned by special
        resolve {
            add_to_hand (1, card, you control, from extra_deck, where is_face_up and archetype == "Zefra" and is_pendulum and not name == "Ritual Beast Tamer Zefrawendi")
        }
    }
}
