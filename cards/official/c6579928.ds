card "Secret Six Samurai - Kizaru" {
    id: 6579928
    type: Effect Monster
    attribute: EARTH
    race: Warrior
    level: 4
    atk: 1900
    def: 1000

    effect "Effect 1" {
        speed: 1
        timing: when
        trigger: summoned by special
        resolve {
            add_to_hand (1, card, you control, from deck, where archetype == "Six Samurai" and is_monster)
        }
    }

    replacement "Effect 2" {
        instead_of: destroyed
