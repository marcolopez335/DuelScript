card "Beast Magic Attack" {
    id: 21984400
    type: Quick-Play Spell

    effect "Effect 1" {
        speed: 2
        once_per_turn: hard
        mandatory
        resolve {
            return (1, card, you control, from monster_zone, where is_face_up and archetype == "Mythical Beast" and is_pendulum) to hand
        }
    }

    effect "Effect 2" {
        speed: 2
        once_per_turn: hard
        mandatory
        resolve {
            special_summon (all, card, either controls)
        }
    }

    effect "Effect 3" {
        speed: 2
        once_per_turn: hard
        mandatory
        resolve {
            special_summon (1, card, you control, from extra_deck, where is_face_up and is_pendulum)
        }
    }
}
