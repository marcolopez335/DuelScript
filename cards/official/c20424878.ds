card "Springans Rockey" {
    id: 20424878
    type: Effect Monster
    attribute: FIRE
    race: Machine
    level: 4
    atk: 1800
    def: 800

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        mandatory
        target (1, card, you control, from monster_zone, where is_face_up and archetype == "Springans" and is_xyz)
        resolve {
            attach self to target as_material
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: soft
        timing: if
        trigger: summoned
        target (1, card, you control, from gy, where ((is_monster and archetype == "Springans") or name == "Great Sand Sea - Gold Golgonda") and not name == "Springans Rockey")
        resolve {
            add_to_hand target
        }
    }

    effect "Effect 3" {
        speed: 1
        once_per_turn: soft
        timing: if
        trigger: summoned by special
        target (1, card, you control, from gy, where ((is_monster and archetype == "Springans") or name == "Great Sand Sea - Gold Golgonda") and not name == "Springans Rockey")
        resolve {
            add_to_hand target
        }
    }
}
