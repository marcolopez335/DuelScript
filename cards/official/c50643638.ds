card "Chanbar, the Flashy Sportsknight" {
    id: 50643638
    type: Synchro Monster
    attribute: LIGHT
    race: Warrior
    level: 8
    atk: 2700
    def: 2100

    summon {
        cannot_normal_summon
        synchro materials {
            tuner: (1, tuner monster)
            non_tuner: (1+, non-tuner monster)
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: hard
        mandatory
        target (1, card, either controls, from field)
        resolve {
            send (1, card, you control, from hand or deck) to gy
            destroy target
        }
    }

    effect "Effect 3" {
        speed: 1
        once_per_turn: soft
        mandatory
        target (2, card, you control, where is_face_up)
        resolve {
            destroy target
            special_summon self
        }
    }
}
