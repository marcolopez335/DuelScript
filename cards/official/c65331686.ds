card "Fluffal Owl" {
    id: 65331686
    type: Effect Monster
    attribute: EARTH
    race: Fairy
    level: 2
    atk: 1000
    def: 1000

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        timing: when
        trigger: summoned
        condition: previous_location == hand
        resolve {
            add_to_hand (1, card, you control, from deck, where name == "Polymerization")
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: hard
        timing: when
        trigger: summoned by special
        condition: previous_location == hand
        resolve {
            add_to_hand (1, card, you control, from deck, where name == "Polymerization")
        }
    }

    effect "Effect 3" {
        speed: 1
        once_per_turn: hard
        mandatory
        cost {
            pay_lp 500
        }
        resolve {
            fusion_summon (1, fusion monster, where archetype == "Frightfur")
        }
    }
}
