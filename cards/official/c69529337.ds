card "Triamid Dancer" {
    id: 69529337
    type: Effect Monster
    attribute: EARTH
    race: Rock
    level: 3
    atk: 600
    def: 1900

    effect "Effect 1" {
        speed: 1
        once_per_turn: soft
        mandatory
        target (1, card, you control, from gy, where archetype == "Triamid")
        resolve {
            send target to deck
            modify_atk (all, card, you control, from monster_zone, where is_face_up and race == Rock) + 500 until while_face_up
            modify_def (all, card, you control, from monster_zone, where is_face_up and race == Rock) + 500 until while_face_up
        }
    }

    effect "Effect 2" {
        speed: 2
        once_per_turn: soft
        resolve {
            send (all, card, either controls) to gy
        }
    }
}
