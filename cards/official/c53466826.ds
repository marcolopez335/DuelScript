card "Heroic Chance" {
    id: 53466826
    type: Normal Spell

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        mandatory
        target (1, card, you control, from monster_zone, where is_face_up and archetype == "Heroic")
        resolve {
            set_atk target target.atk * 2 until end_of_turn
            grant target cannot_attack_directly until end_of_turn
        }
    }
}
