card "Muckraker From the Underworld" {
    id: 71607202
    type: Link Monster
    attribute: DARK
    race: Fiend
    link: 2
    link_arrows: [left, bottom]
    atk: 1000

    summon {
        cannot_normal_summon
        link materials: (2, effect monster)
    }

    passive "Effect 4" {
        scope: self
        grant: cannot_attack
    }

    effect "Effect 3" {
        speed: 1
        once_per_turn: hard
        mandatory
        target (1, card, you control, from gy, where race == Fiend and not name == "Muckraker From the Underworld")
        resolve {
            discard (1, card, you control, from hand)
            special_summon target
            restrict you cannot_special_summon except (race == Fiend) end_of_turn
        }
    }

    replacement "Effect 2" {
        instead_of: destroyed
        do {
            banish self
        }
    }
}
