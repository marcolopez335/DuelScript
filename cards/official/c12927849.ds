card "SZW - Fenrir Sword" {
    id: 12927849
    type: Effect Monster
    attribute: LIGHT
    race: Beast
    level: 4
    atk: 1800
    def: 1100

    passive "Effect 7" {
        scope: self
        grant: cannot_be_targeted by effects
    }

    passive "Effect 8" {
        scope: self
        grant: cannot_be_destroyed by effect
    }

    passive "Effect 9" {
        scope: self
        grant: cannot_be_destroyed by battle
    }

    effect "Effect 1" {
        speed: 1
        timing: when
        trigger: summoned
        target (1, card, you control, from spell_trap_zone, where is_face_up and archetype == "ZW")
        resolve {
            special_summon target in defense_position
        }
    }

    effect "Effect 2" {
        speed: 1
        mandatory
        resolve {
            send (all, card, either controls) to gy
        }
    }

    effect "Effect 3" {
        speed: 1
        timing: when
        trigger: battle_damage
        target (1, card, you control, from gy, where archetype == "ZW" and is_monster)
        resolve {
            add_to_hand target
        }
    }
}
