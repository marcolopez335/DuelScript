card "Zefra Providence" {
    id: 74580251
    type: Normal Spell

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        mandatory
        resolve {
            add_to_hand (1, card, you control, from deck, where archetype == "Zefra" and not name == "Zefra Providence")
        }
    }

    replacement "Effect 2" {
        instead_of: destroyed
        do {
            banish self
        }
    }
}
