card "Bacha the Melodious Maestra" {
    id: 56208713
    type: Fusion Monster
    attribute: LIGHT
    race: Fairy
    level: 7
    atk: 2500
    def: 1800

    summon {
        cannot_normal_summon
        fusion materials: (2, monster, where archetype == "Melodious")
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: summoned by special
        resolve {
            special_summon (1, card, you control, from deck, where archetype == "Melodious")
        }
    }

    effect "Effect 3" {
        speed: 1
        once_per_turn: soft
        timing: if
        trigger: custom "chain_end"
        target (1, card, you control, from gy, where archetype == "Melodious" and not name == "Bacha the Melodious Maestra")
        resolve {
            special_summon target in defense_position
        }
    }
}
