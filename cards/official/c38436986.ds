card "Tearlaments Metanoise" {
    id: 38436986
    type: Normal Trap

    effect "Effect 1" {
        speed: 2
        once_per_turn: hard
        mandatory
        target (1, card, opponent controls, from monster_zone, where is_face_up)
        resolve {
            change_position target to face_down_defense
            send (1, card, you control, from deck, where archetype == "Tearlaments" and is_monster) to gy
        }
    }

    effect "Effect 2" {
        speed: 2
        once_per_turn: hard
        timing: if
        trigger: custom "chain_end"
        target (1, card, you control, from gy, where archetype == "Tearlaments" and is_monster)
        resolve {
            add_to_hand target
        }
    }
}
