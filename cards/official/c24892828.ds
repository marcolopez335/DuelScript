card "Returned of the Tistina" {
    id: 24892828
    type: Effect Monster
    attribute: FIRE
    race: Aqua
    level: 2
    atk: 500
    def: 500

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        mandatory
        target (1, card, you control, from monster_zone, where is_face_up and is_monster and not is_xyz and not is_link and archetype == "Tistina" and not name == "Returned of the Tistina")
        resolve {
            special_summon self
            set_level self target.level until while_face_up
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: soft
        mandatory
        resolve {
            attach self to target as_material
        }
    }
}
