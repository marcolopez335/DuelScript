card "Rescue-ACE Monitor" {
    id: 91222209
    type: Effect Monster
    attribute: FIRE
    race: Warrior
    level: 4
    atk: 1800
    def: 1800

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: summoned
        resolve {
            add_to_hand (1, card, you control, from deck, where archetype == "Rescue-ACE" and is_trap)
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: summoned by special
        resolve {
            add_to_hand (1, card, you control, from deck, where archetype == "Rescue-ACE" and is_trap)
        }
    }

    effect "Effect 3" {
        speed: 2
        once_per_turn: soft
        timing: when
        trigger: opponent_activates [activate_spell, activate_trap, activate_spell]
        cost {
            tribute self
        }
        target (1, card, you control, from gy, where archetype == "Rescue-ACE" and not name == "Rescue-ACE Monitor")
        resolve {
            special_summon target
        }
    }
}
