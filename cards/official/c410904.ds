card "Awakening of the Possessed - Rasenryu" {
    id: 410904
    type: Effect Monster
    attribute: WIND
    race: Dragon
    level: 5
    atk: 2000
    def: 200

    summon {
        tributes: 1
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: hard
        timing: when
        trigger: summoned by special
        resolve {
            return (1, card, opponent controls, from field) to hand
        }
    }

    effect "Effect 3" {
        speed: 1
        once_per_turn: soft
        timing: if
        trigger: custom "chain_end"
        condition: previous_location == field
        resolve {
            add_to_hand (1, card, you control, from deck, where archetype == "Spiritual Wind Art" or (archetype == "Possessed" and (is_spell or is_trap)))
        }
    }
}
