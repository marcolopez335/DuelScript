card "Evil HERO Vicious Claws" {
    id: 35095329
    type: Effect Monster
    attribute: DARK
    race: Fiend
    level: 7
    atk: 2500
    def: 2500

    summon {
        tributes: 2
    }

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        mandatory
        target (1, card, either controls, from monster_zone, where is_face_up and archetype == "HERO")
        resolve {
            special_summon self in defense_position
            modify_atk target + 300 until while_face_up
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: soft
        timing: if
        trigger: destroyed
        resolve {
            special_summon (all, card, either controls)
            destroy (all, card, either controls)
        }
    }
}
