card "Constellar Omega" {
    id: 26329679
    type: Xyz Monster
    attribute: LIGHT
    race: Beast-Warrior
    rank: 4
    atk: 2400
    def: 500

    summon {
        cannot_normal_summon
        xyz materials: (2, monster, where level == 4 and attribute == LIGHT)
    }

    effect "Effect 1" {
        speed: 2
        once_per_turn: soft
        cost {
            detach 1 from self
        }
        resolve {
            grant (all, card, you control, from monster_zone, where is_face_up and archetype == "Constellar") unaffected_by spells until end_of_turn
            grant (all, card, you control, from monster_zone, where is_face_up and archetype == "Constellar") unaffected_by traps until end_of_turn
        }
    }
}
