card "Performapal Sellshell Crab" {
    id: 23377694
    type: Effect Monster | Pendulum Monster
    attribute: WATER
    race: Aqua
    level: 5
    scale: 2
    atk: 500
    def: 2500

    summon {
        tributes: 1
    }

    effect "Effect 1" {
        speed: 1
        once_per_turn: soft
        mandatory
        target (1, card, you control, from monster_zone, where is_face_up and is_pendulum)
        resolve {
            modify_atk target + count((all, card, you control, from monster_zone, where is_face_up and archetype == "Performapal")) * 300 until end_of_turn
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: soft
        timing: when
        trigger: battle_damage
        target (1, card, you control, from pendulum_zone, where archetype == "Performapal" or archetype == "Odd-Eyes")
        resolve {
            special_summon target
        }
    }
}
