card "Hi-Speedroid Glider #2" {
    id: 10732060
    type: Synchro Monster | Tuner
    attribute: WIND
    race: Machine
    level: 5
    atk: 1600
    def: 2200

    summon {
        cannot_normal_summon
        special_summon_procedure {
            from: extra_deck
            to: your_field
        }
    }

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: summoned by special
        target (1, card, you control, from gy, where not is_tuner and level <= 7 and attribute == WIND and is_synchro)
        resolve {
            special_summon target
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: soft
        timing: if
        trigger: summoned by special
        cost {
            banish self
        }
        resolve {
            modify_level (all, card, opponent controls, from monster_zone, where is_face_up and is_monster and not is_xyz and not is_link) + 5 until while_face_up
        }
    }
}
