card "Dragunity Knight - Gae Dearg" {
    id: 34116027
    type: Synchro Monster
    attribute: WIND
    race: Dragon
    level: 6
    atk: 2400
    def: 800

    summon {
        cannot_normal_summon
        special_summon_procedure {
            from: extra_deck
            to: your_field
        }
    }

    effect "Effect 1" {
        speed: 1
        once_per_turn: soft
        mandatory
        resolve {
            add_to_hand (1, card, you control, from deck, where level <= 4 and (race == Dragon or race == Winged Beast))
            shuffle_hand yours
            discard (1, card, you control, from hand, where race == Dragon or race == Winged Beast)
        }
    }
}
