card "Edea the Heavenly Squire" {
    id: 95457011
    type: Effect Monster
    attribute: LIGHT
    race: Warrior
    level: 1
    atk: 800
    def: 1000

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: summoned
        resolve {
            special_summon (all, card, either controls)
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: summoned by special
        resolve {
            special_summon (all, card, either controls)
        }
    }

    effect "Effect 3" {
        speed: 1
        once_per_turn: soft
        timing: if
        trigger: custom "chain_end"
        target (1, card, you control, from banished, where is_face_up and archetype == "Monarch" and (is_spell or is_trap))
        resolve {
            add_to_hand target
        }
    }
}
