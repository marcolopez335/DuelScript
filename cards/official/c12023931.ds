card "Booster Dragon" {
    id: 12023931
    type: Link Monster
    attribute: DARK
    race: Dragon
    link: 2
    link_arrows: [bottom_left, bottom_right]
    atk: 1900

    summon {
        cannot_normal_summon
        link materials: (2, monster, where archetype == "Rokket")
    }

    effect "Effect 1" {
        speed: 1
        once_per_turn: soft
        mandatory
        target (1, card, either controls, from monster_zone, except self, where is_face_up)
        resolve {
            modify_atk target + 500 until while_face_up
            modify_def target + 500 until while_face_up
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: custom "chain_end"
        target (1, card, you control, from gy, except self, where race == Dragon)
        resolve {
            special_summon target
        }
    }
}
