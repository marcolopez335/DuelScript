card "Special Schedule" {
    id: 97520701
    type: Normal Spell

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        mandatory
        target (1, card, you control, from gy, where race == Machine and atk >= 3000)
        resolve {
            special_summon target in defense_position
        }
    }

    effect "Effect 2" {
        speed: 1
        timing: if
        trigger: custom "chain_end"
        target (1, card, you control, from gy, where level == 10 and race == Machine)
        resolve {
            add_to_hand target
        }
    }
}
