card "Harpie Harpist" {
    id: 56585883
    type: Effect Monster
    attribute: WIND
    race: Winged Beast
    level: 4
    atk: 1700
    def: 600

    effect "Effect 2" {
        speed: 1
        once_per_turn: hard
        timing: when
        trigger: summoned
        target (1, card, you control, from monster_zone, except self, where is_face_up and race == Winged Beast)
        resolve {
            add_to_hand target
        }
    }

    effect "Effect 4" {
        speed: 1
        once_per_turn: soft
        timing: when
        trigger: end_phase
        resolve {
            add_to_hand (1, card, you control, from deck, where atk <= 1500 and race == Winged Beast and level == 4)
        }
    }
}
