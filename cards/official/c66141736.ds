card "Red Rising Dragon" {
    id: 66141736
    type: Synchro Monster
    attribute: DARK
    race: Dragon
    level: 6
    atk: 2100
    def: 1600

    summon {
        cannot_normal_summon
        synchro materials {
            tuner: (1, tuner monster, where race == Fiend)
            non_tuner: (1+, non-tuner monster)
        }
    }

    effect "Effect 1" {
        speed: 1
        timing: when
        trigger: summoned by special
        target (1, card, you control, from gy, where archetype == "Resonator")
        resolve {
            special_summon target
        }
    }

    effect "Effect 2" {
        speed: 1
        mandatory
        cost {
            banish self
        }
        target (2, card, you control, from gy, except self, where archetype == "Resonator" and level == 1)
        resolve {
            special_summon target
        }
    }
}
