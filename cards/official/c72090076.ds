card "Nemeses Corridor" {
    id: 72090076
    type: Effect Monster
    attribute: WIND
    race: Thunder
    level: 4
    atk: 1900
    def: 600

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        mandatory
        resolve {
            special_summon (all, card, either controls)
            return (all, card, either controls) to deck
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: soft
        mandatory
        target (1, card, you control, from banished, where archetype == "Nemeses" and is_monster and is_face_up and not name == "Nemeses Corridor")
        resolve {
            add_to_hand target
        }
    }
}
