    type: Effect Monster
    attribute: LIGHT
    race: Machine
    level: 6
    atk: 1000
    def: 2000

    summon {
        tributes: 1
    }

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: summoned
        resolve {
            special_summon self
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: summoned by special
        resolve {
            special_summon self
        }
    }

    effect "Effect 3" {
        speed: 1
        once_per_turn: soft
        mandatory
        resolve {
            set_level target 8 until end_of_turn
        }
    }

    effect "Effect 4" {
        speed: 1
        once_per_turn: soft
        timing: if
        trigger: custom "chain_end"
        cost {
            banish self
        }
        resolve {
            add_to_hand (1, card, you control, from deck, where archetype == "Cipher" and is_monster)
        }
