card "Constellar Caduceus" {
    id: 82913020
    type: Effect Monster
    attribute: LIGHT
    race: Spellcaster
    level: 4
    atk: 1600
    def: 1550

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        mandatory
        resolve {
            special_summon self
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: soft
        mandatory
        resolve {
            add_to_hand (1, card, you control, from deck, where (is_spell or is_trap) and archetype == "Constellar")
        }
    }
}
