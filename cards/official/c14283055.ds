card "Concours de Cuisine (Culinary Confrontation)" {
    id: 14283055
    type: Quick-Play Spell

    effect "Effect 1" {
        speed: 2
        once_per_turn: hard
        mandatory
        resolve {
            special_summon (all, card, either controls)
            special_summon (all, card, either controls)
        }
    }

    effect "Effect 2" {
        speed: 2
        once_per_turn: soft
        mandatory
        cost {
            banish self
        }
        target (1, card, either controls, from monster_zone, where is_face_up)
        resolve {
            modify_atk target + count((all, card, either controls, from gy, where archetype == "Recipe")) * 200 until while_face_up
        }
    }
}
