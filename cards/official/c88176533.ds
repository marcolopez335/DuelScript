card "Devotee of Nephthys" {
    id: 88176533
    type: Ritual Monster
    attribute: WIND
    race: Spellcaster
    level: 2
    atk: 1200
    def: 1200

    summon {
        cannot_normal_summon
    }

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: summoned by special
        resolve {
            special_summon (1, card, you control, from deck)
            install_watcher "desop" { event: end_phase duration: end_of_turn check { destroy self } }
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: soft
        mandatory
        resolve {
            destroy (1, card, you control, from hand)
            special_summon self
        }
    }
}
