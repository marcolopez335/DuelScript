card "Springans Brothers" {
    id: 67436768
    type: Effect Monster
    attribute: FIRE
    race: Machine
    level: 4
    atk: 300
    def: 1800

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: custom "chain_end"
        target (1, card, you control, from gy, where archetype == "Springans" and not name == "Springans Brothers")
        resolve {
            special_summon target
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: soft
        mandatory
        target (1, card, you control, from monster_zone, except self, where is_face_up and archetype == "Springans" and is_xyz)
        resolve {
            attach self to target as_material
        }
    }
}
