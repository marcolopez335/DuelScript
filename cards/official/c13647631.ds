card "Heavy Freight Train Derricrane" {
    id: 13647631
    type: Effect Monster
    attribute: EARTH
    race: Machine
    level: 10
    atk: 2800
    def: 2000

    summon {
        tributes: 2
    }

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: summoned
        resolve {
            special_summon self
            set_atk self self.base_atk / 2 until while_face_up
            set_def self self.base_def / 2 until while_face_up
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: summoned by special
        resolve {
            special_summon self
            set_atk self self.base_atk / 2 until while_face_up
            set_def self self.base_def / 2 until while_face_up
        }
    }

    effect "Effect 3" {
        speed: 1
        timing: if
        trigger: custom "chain_end"
        target (1, card, opponent controls, from field)
        resolve {
            destroy target
        }
    }
}
