card "Superheavy Samurai Fist" {
    id: 71386411
    type: Effect Monster | Tuner
    attribute: EARTH
    race: Machine
    level: 2
    atk: 900
    def: 900

    effect "Effect 1" {
        speed: 2
        once_per_turn: hard
        resolve {
            synchro_summon (1, card, you control, from extra_deck) using self
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: soft
        mandatory
        target (1, card, you control, from monster_zone, where is_face_up and level >= 2 and archetype == "Superheavy Samurai" and is_synchro)
        resolve {
            special_summon self
            restrict you cannot_special_summon except (archetype == "Superheavy Samurai") end_of_turn
            modify_level target - 1 until while_face_up
        }
    }
}
