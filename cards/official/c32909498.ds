card "Kashtira Fenrir" {
    id: 32909498
    type: Effect Monster
    attribute: EARTH
    race: Psychic
    level: 7
    atk: 2400
    def: 2400

    summon {
        tributes: 2
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: hard
        mandatory
        resolve {
            add_to_hand (1, card, you control, from deck, where archetype == "Kashtira" and is_monster)
        }
    }

    effect "Effect 3" {
        speed: 1
        once_per_turn: soft
        timing: when
        trigger: summoned
        target (1, card, opponent controls, from field, where is_face_up)
        resolve {
            banish target
        }
    }

    effect "Effect 4" {
        speed: 1
        once_per_turn: soft
        timing: if
        trigger: opponent_activates [activate_spell, activate_trap, activate_spell]
        target (1, card, opponent controls, from field, where is_face_up)
        resolve {
            banish target
        }
    }
}
