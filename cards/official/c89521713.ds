card "Madolche Cruffssant" {
    id: 89521713
    type: Effect Monster
    attribute: EARTH
    race: Beast
    level: 3
    atk: 1500
    def: 1200

    effect "Effect 1" {
        speed: 1
        mandatory
        trigger: custom "chain_end"
        resolve {
            send self to deck
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: soft
        mandatory
        target (1, card, you control, from field, except self, where is_face_up and archetype == "Madolche")
        resolve {
            add_to_hand target
            modify_level self + 1 until while_face_up
            modify_atk self + 300 until while_face_up
        }
    }
}
