card "Battlin' Boxer Uppercutter" {
    id: 11522479
    type: Effect Monster
    attribute: FIRE
    race: Warrior
    level: 4
    atk: 1600
    def: 200

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: summoned
        resolve {
            add_to_hand (1, card, you control, from deck, where ((archetype == "Battlin' Boxer" and is_monster) or (archetype == "Counter" and type == Counter Trap)) and not name == "Battlin' Boxer Uppercutter")
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: summoned by special
        resolve {
            add_to_hand (1, card, you control, from deck, where ((archetype == "Battlin' Boxer" and is_monster) or (archetype == "Counter" and type == Counter Trap)) and not name == "Battlin' Boxer Uppercutter")
        }
    }

    effect "Effect 3" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: custom "chain_end"
        resolve {
            special_summon (all, card, either controls)
        }
    }
}
