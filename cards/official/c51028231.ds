card "Abyss Actor - Sassy Rookie" {
    id: 51028231
    type: Effect Monster | Pendulum Monster
    attribute: DARK
    race: Fiend
    level: 4
    scale: 2
    atk: 1700
    def: 1000

    passive "Effect 2" {
        scope: self
        grant: cannot_be_destroyed
    }

    effect "Effect 3" {
        speed: 1
        timing: if
        trigger: destroyed
        resolve {
            special_summon (1, card, you control, from deck, where archetype == "Abyss Actor" and level <= 4 and not name == "Abyss Actor - Sassy Rookie")
        }
    }

    effect "Effect 4" {
        speed: 1
        timing: if
        trigger: destroyed
        target (1, card, opponent controls, from monster_zone, where is_face_up and level <= 4)
        resolve {
            destroy target
        }
    }

    replacement "Effect 1" {
        instead_of: destroyed
        do {
            return self to extra_deck
        }
    }
}
