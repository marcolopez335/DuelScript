card "Azamina Sol Erysichthon" {
    id: 9785661
    type: Fusion Monster
    attribute: DARK
    race: Warrior
    level: 6
    atk: 2700
    def: 0

    summon {
        cannot_normal_summon
        fusion materials: (1, monster, where race == Illusion) + (1, monster, where race == Fiend)
    }

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: summoned by special
        target (1, card, either controls, from field)
        resolve {
            send target to gy
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: soft
        timing: when
        trigger: standby_phase
        target (1, card, you control, from gy, where archetype == "Azamina" or archetype == "Sinful Spoils")
        resolve {
            add_to_hand target
        }
    }
}
