card "Curse of Diabell" {
    id: 64998567
    type: Normal Trap

    effect "Effect 1" {
        speed: 2
        once_per_turn: hard
        mandatory
        cost {
            send self to gy
        }
        resolve {
            destroy (all, card, either controls)
        }
    }

    effect "Effect 2" {
        speed: 2
        once_per_turn: soft
        timing: if
        trigger: custom "chain_end"
        resolve {
            add_to_hand (1, card, you control, from deck, where archetype == "Diabell" and (is_spell or is_trap) and not name == "Curse of Diabell")
        }
    }
}
