card "Virgil, Rock Star of the Burning Abyss" {
    id: 601193
    type: Synchro Monster
    attribute: LIGHT
    race: Spellcaster
    level: 6
    atk: 2500
    def: 1000

    summon {
        cannot_normal_summon
        synchro materials {
            tuner: (1, tuner monster)
            non_tuner: (1+, non-tuner monster)
        }
    }

    effect "Effect 1" {
        speed: 1
        once_per_turn: soft
        mandatory
        target (1, card, opponent controls)
        resolve {
            send target to deck
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: custom "chain_end"
        resolve {
            draw 1
        }
    }
}
