card "Leraje the God of Archery" {
    id: 49922726
    type: Effect Monster
    attribute: DARK
    race: Fiend
    level: 4
    atk: 1800
    def: 1600

    effect "Effect 1" {
        speed: 1
        timing: when
        trigger: summoned
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: hard
        mandatory
        target (1, card, either controls, from monster_zone, except self, where is_face_up and def >= 0)
        resolve {
            destroy target
            grant self cannot_attack until end_of_turn
            modify_def target - self.atk until while_face_up
        }
    }
}
