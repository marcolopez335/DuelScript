card "Galaxy Cyclone" {
    id: 5133471
    type: Normal Spell

    effect "Effect 1" {
        speed: 1
        mandatory
        target (1, card, either controls, from field, except self, where is_face_down and (is_spell or is_trap))
        resolve {
            destroy target
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: hard
        mandatory
        cost {
            banish self
        }
        target (1, card, either controls, from field, except self, where is_face_up and (is_spell or is_trap))
        resolve {
            destroy target
        }
    }
}
