card "Rescue-ACE Preventer" {
    id: 41443249
    type: Effect Monster
    attribute: FIRE
    race: Machine
    level: 8
    atk: 2800
    def: 2800

    summon {
        tributes: 2
    }

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        mandatory
        cost {
            banish self
        }
        resolve {
            special_summon (all, card, either controls)
        }
    }

    effect "Effect 2" {
        speed: 2
        once_per_turn: soft
        target (1, card, opponent controls, from monster_zone, where is_face_up and is_effect)
        resolve {
            change_position target to face_down_defense
        }
    }

    effect "Effect 3" {
        speed: 1
        once_per_turn: soft
        timing: if
        trigger: custom "chain_end"
        target (1, card, you control, from banished, where is_face_up and archetype == "Rescue-ACE" and not level == 8)
        resolve {
            special_summon target
        }
    }
}
