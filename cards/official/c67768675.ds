card "Kaibaman the Legend" {
    id: 67768675
    type: Effect Monster | Tuner
    attribute: LIGHT
    race: Warrior
    level: 1
    atk: 200
    def: 700

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: summoned
        resolve {
            shuffle_hand yours
            shuffle_deck yours
            special_summon (1, card, you control, from hand or deck or gy)
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: summoned by special
        resolve {
            shuffle_hand yours
            shuffle_deck yours
            special_summon (1, card, you control, from hand or deck or gy)
        }
    }

    effect "Effect 3" {
        speed: 1
        once_per_turn: soft
        timing: when
        trigger: summoned by special
        cost {
            banish self
        }
        resolve {
            add_to_hand (1, monster, where archetype == "Blue-Eyes") from deck
        }
    }
}
