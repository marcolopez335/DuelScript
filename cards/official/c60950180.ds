card "Raidraptor - Sharp Lanius" {
    id: 60950180
    type: Effect Monster
    attribute: DARK
    race: Winged Beast
    level: 4
    atk: 1700
    def: 1000

    effect "Effect 1" {
        speed: 1
        once_per_turn: soft
        mandatory
        target (1, card, either controls, from monster_zone, in attack_position, where is_face_up)
        resolve {
            change_position target to defense_position
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: hard
        mandatory
        target (1, card, you control, from gy, where archetype == "Raidraptor")
        resolve {
            special_summon target
        }
    }
}
