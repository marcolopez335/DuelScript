card "Nobledragon Magician" {
    id: 88935103
    type: Effect Monster | Pendulum Monster | Tuner
    attribute: FIRE
    race: Spellcaster
    level: 3
    scale: 5
    atk: 700
    def: 1400

    effect "Effect 5" {
        speed: 1
        mandatory
        target (1, card, you control, from monster_zone, where is_face_up and level >= 7 and archetype == "Odd-Eyes")
        resolve {
            special_summon self
            modify_level target - 3 until while_face_up
        }
    }
}
