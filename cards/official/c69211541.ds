card "Performapal Partnaga" {
    id: 69211541
    type: Effect Monster | Pendulum Monster
    attribute: EARTH
    race: Reptile
    level: 5
    scale: 3
    atk: 500
    def: 2100

    summon {
        tributes: 1
    }

    passive "Effect 4" {
        scope: self
        grant: cannot_attack
    }

    effect "Effect 1" {
        speed: 1
        once_per_turn: soft
        mandatory
        target (1, card, you control, from monster_zone, where is_face_up)
        resolve {
            modify_atk target + count((all, card, you control, from field, where is_face_up and archetype == "Performapal")) * 300 until end_of_turn
        }
    }

    effect "Effect 2" {
        speed: 1
        timing: if
        trigger: summoned
        target (1, card, you control, from monster_zone, where is_face_up)
        resolve {
            modify_atk target + count((all, card, you control, from monster_zone, where is_face_up and archetype == "Performapal")) * 300 until while_face_up
        }
    }

    effect "Effect 3" {
        speed: 1
        timing: if
        trigger: summoned by special
        target (1, card, you control, from monster_zone, where is_face_up)
        resolve {
            modify_atk target + count((all, card, you control, from monster_zone, where is_face_up and archetype == "Performapal")) * 300 until while_face_up
        }
    }
}
