card "Cyberse Integrator" {
    id: 25200959
    type: Synchro Monster
    attribute: LIGHT
    race: Cyberse
    level: 3
    atk: 1000
    def: 1000

    summon {
        cannot_normal_summon
        synchro materials {
            tuner: (1, tuner monster)
            non_tuner: (1+, non-tuner monster)
        }
    }

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: summoned by special
        resolve {
            special_summon (1, card, you control, from gy or hand) in defense_position
            restrict you cannot_special_summon except (race == Cyberse) end_of_turn
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: soft
        timing: if
        trigger: custom "chain_end"
        resolve {
            draw 1
        }
    }
}
