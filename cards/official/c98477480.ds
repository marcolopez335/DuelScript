card "Barrier of the Voiceless Voice" {
    id: 98477480
    type: Continuous Spell

    passive "Effect 2" {
        scope: self
        grant: cannot_be_targeted by effects
    }

    passive "Effect 3" {
        scope: self
        grant: cannot_be_targeted by effects
    }

    effect "Effect 1" {
        speed: 1
        mandatory
        resolve {
            add_to_hand (1, card, you control, from deck)
        }
    }

    effect "Effect 4" {
        speed: 1
        once_per_turn: hard
        mandatory
        resolve {
            add_to_hand (1, card, you control, from deck, where (archetype == "Voiceless Voice" or (archetype == "Skull Guardian" and is_monster and is_ritual)) and not name == "Barrier of the Voiceless Voice")
        }
    }
}
