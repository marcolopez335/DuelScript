card "Gouki Bearhug" {
    id: 12097275
    type: Effect Monster
    attribute: EARTH
    race: Warrior
    level: 6
    atk: 2400
    def: 0

    summon {
        tributes: 1
    }

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: summoned
        target (1, card, opponent controls, from monster_zone, where is_face_up and atk > 0)
        resolve {
            set_atk target (target.base_atk + 1) / 2 until end_of_turn
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: summoned by special
        target (1, card, opponent controls, from monster_zone, where is_face_up and atk > 0)
        resolve {
            set_atk target (target.base_atk + 1) / 2 until end_of_turn
        }
    }

    effect "Effect 3" {
        speed: 1
        once_per_turn: soft
        timing: if
        trigger: custom "chain_end"
        condition: previous_location == field
        resolve {
            add_to_hand (1, card, you control, from deck, where archetype == "Gouki" and not name == "Gouki Bearhug")
        }
    }
}
