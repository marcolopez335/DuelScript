card "Twilight Cloth" {
    id: 83747250
    type: Normal Trap

    effect "Effect 1" {
        speed: 2
        mandatory
        resolve {
            banish (all, card, either controls)
        }
    }

    effect "Effect 2" {
        speed: 2
        timing: if
        trigger: custom "chain_end"
        resolve {
            grant (all, card, you control, from monster_zone, where archetype == "Lightsworn") cannot_be_destroyed by battle until end_of_turn
            grant (all, card, you control, from monster_zone, where archetype == "Lightsworn") cannot_be_destroyed by effect until end_of_turn
        }
    }
}
