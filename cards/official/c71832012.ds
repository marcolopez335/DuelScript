card "Pressured Planet Wraitsoth" {
    id: 71832012
    type: Field Spell

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        mandatory
        resolve {
            add_to_hand (1, card, you control, from deck, where is_monster and archetype == "Kashtira")
        }
    }

    effect "Effect 4" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: opponent_activates [activate_spell, activate_trap, activate_spell]
        target (1, card, either controls, from field)
        resolve {
            destroy target
        }
    }
}
