card "Crystal Girl" {
    id: 93169863
    type: Effect Monster
    attribute: WATER
    race: Spellcaster
    level: 1
    atk: 200
    def: 100

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: summoned
        resolve {
            delayed on end_phase until end_of_turn { add_to_hand (1, card, you control, from deck, where level >= 5 and attribute == WATER) }
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: summoned by special
        resolve {
            delayed on end_phase until end_of_turn { add_to_hand (1, card, you control, from deck, where level >= 5 and attribute == WATER) }
        }
    }

    effect "Effect 3" {
        speed: 1
        once_per_turn: soft
        mandatory
        resolve {
            special_summon (all, card, either controls)
        }
    }
}
