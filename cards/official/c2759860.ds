card "Graydle Impact" {
    id: 2759860
    type: Continuous Spell

    effect "Effect 1" {
        speed: 1
        mandatory
        resolve {
            destroy target
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: hard
        mandatory
        target (1, card, you control, from field, except self, where is_face_up and archetype == "Graydle")
        resolve {
            destroy target
        }
    }

    effect "Effect 3" {
        speed: 1
        once_per_turn: hard
        timing: when
        trigger: end_phase
        resolve {
            add_to_hand (1, card, you control, from deck, where archetype == "Graydle")
        }
    }
}
