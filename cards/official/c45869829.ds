card "Quick Booster" {
    id: 45869829
    type: Quick-Play Spell

    effect "Effect 1" {
        speed: 2
        mandatory
        target (1, card, you control, from gy, where type == Quick-Play Spell and not name == "Quick Booster")
        resolve {
            send target to deck
        }
    }

    effect "Effect 2" {
        speed: 2
        timing: if
        trigger: custom "chain_end"
        resolve {
            add_to_hand (1, card, you control, from deck, where type == Quick-Play Spell and not name == "Quick Booster")
        }
    }
}
