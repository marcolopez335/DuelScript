card "Ashened for Eternity" {
    id: 66848311
    type: Continuous Trap

    effect "Effect 1" {
        speed: 2
        once_per_turn: hard
        mandatory
        resolve {
            add_to_hand (1, card, you control, from gy, where name == "Veidos the Eruption Dragon of Extinction" or (archetype == "Ashened" and is_monster))
        }
    }

    effect "Effect 2" {
        speed: 2
        once_per_turn: soft
        resolve {
            take_control (all, card, either controls)
        }
    }
}
