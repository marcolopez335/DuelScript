card "Mikanko Shinbu - Noble Twins" {
    id: 84550369
    type: Normal Spell

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        mandatory
        resolve {
            send (1, card, you control, from deck, where archetype == "Mikanko" and not name == "Mikanko Shinbu - Noble Twins") to gy
            set (1, card, you control, from deck, where archetype == "Mikanko" and (is_spell or is_trap) and not name == "Mikanko Shinbu - Noble Twins")
            restrict you cannot_special_summon from extra_deck except (archetype == "Mikanko") end_of_turn
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: hard
        mandatory
        cost {
            banish self
        }
        resolve {
            special_summon (all, card, either controls)
        }
    }
}
