card "Explosive Magician" {
    id: 33413279
    type: Synchro Monster
    attribute: LIGHT
    race: Spellcaster
    level: 6
    atk: 2500
    def: 1800

    summon {
        cannot_normal_summon
        synchro materials {
            tuner: (1, tuner monster)
            non_tuner: (1+, non-tuner monster, where race == Spellcaster)
        }
    }

    effect "Effect 1" {
        speed: 1
        mandatory
        target (1, card, opponent controls, from field, where is_spell or is_trap)
        resolve {
            destroy target
        }
    }
}
