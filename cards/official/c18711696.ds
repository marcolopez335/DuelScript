card "Assault Sonic Warrior" {
    id: 18711696
    type: Effect Monster
    attribute: DARK
    race: Fiend
    level: 1
    atk: 0
    def: 0

    effect "Effect 1" {
        speed: 1
        once_per_turn: soft
        mandatory
        resolve {
            special_summon self
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: soft
        timing: if
        trigger: summoned
        resolve {
            add_to_hand (1, card, you control, from deck, where (archetype == "Synchron" and is_monster) or name == "Assault Mode Activate")
        }
    }

    effect "Effect 3" {
        speed: 1
        once_per_turn: soft
        timing: if
        trigger: summoned by special
        resolve {
            add_to_hand (1, card, you control, from deck, where (archetype == "Synchron" and is_monster) or name == "Assault Mode Activate")
        }
    }
}
