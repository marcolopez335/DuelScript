card "WAKE CUP! Macchia" {
    id: 71410542
    type: Effect Monster
    attribute: WIND
    race: Aqua
    level: 3
    atk: 1000
    def: 100

    effect "Effect 1" {
        speed: 1
        once_per_turn: soft
        timing: when
        trigger: end_phase
        target (1, card, either controls, from field, where is_face_down)
        resolve {
            send target to gy
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: hard
        mandatory
        resolve {
            special_summon (all, card, either controls)
        }
    }

    effect "Effect 3" {
        speed: 1
        once_per_turn: soft
        mandatory
        trigger: custom "chain_active"
        target (1, card, either controls, from monster_zone, in defense_position, where is_face_down)
        resolve {
            change_position target to attack_position
        }
    }
}
