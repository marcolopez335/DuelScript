card "Ghostrick Dullahan" {
    id: 46895036
    type: Xyz Monster
    attribute: DARK
    race: Fiend
    rank: 1
    atk: 1000
    def: 0

    summon {
        cannot_normal_summon
        xyz materials: (2, monster, where level == 1)
    }

    effect "Effect 2" {
        speed: 2
        once_per_turn: soft
        cost {
            detach 1 from self
        }
        target (1, card, either controls, from monster_zone, where is_face_up)
        resolve {
            set_atk target target.atk / 2 until end_of_turn
        }
    }

    effect "Effect 3" {
        speed: 1
        timing: if
        trigger: custom "chain_end"
        target (1, card, you control, from gy, except self, where archetype == "Ghostrick")
        resolve {
            add_to_hand target
        }
    }
}
