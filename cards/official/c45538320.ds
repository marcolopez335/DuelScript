card "Familiars of the Spiritual Arts" {
    id: 45538320
    type: Effect Monster
    attribute: DARK
    race: Fiend
    level: 1
    atk: 0
    def: 0

    effect "Effect 1" {
        speed: 1
        once_per_turn: soft
        timing: if
        trigger: summoned
        resolve {
            add_to_hand (1, card, you control, from deck, where name == "Grand Spiritual Art - Ichirin" or ((is_spell or is_trap) and archetype == "Possessed"))
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: soft
        timing: if
        trigger: summoned by special
        resolve {
            add_to_hand (1, card, you control, from deck, where name == "Grand Spiritual Art - Ichirin" or ((is_spell or is_trap) and archetype == "Possessed"))
        }
    }

    effect "Effect 3" {
        speed: 1
        once_per_turn: soft
        mandatory
        resolve {
            special_summon (1, card, you control)
        }
    }
}
