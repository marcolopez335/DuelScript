            modify_atk target + 500 * count((all, card, either controls, from banished, where is_face_up and is_monster)) until while_face_up
        }
    }

    effect "Effect 3" {
        speed: 1
        mandatory
        resolve {
        }
    }


    passive "Passive 4" {
        target: equipped_card
        modifier: atk + 500
    }
}
