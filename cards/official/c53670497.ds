card "Hieratic Seal From the Ashes" {
    id: 53670497
    type: Continuous Trap

    effect "Effect 1" {
        speed: 2
        mandatory
        resolve {
            send (1, card, you control, from deck) to gy
        }
    }

    effect "Effect 2" {
        speed: 2
        once_per_turn: soft
        resolve {
            send (1, card, you control, from deck, where archetype == "Hieratic" and is_monster) to gy
        }
    }

    effect "Effect 3" {
        speed: 2
        once_per_turn: soft
        target (1, card, you control, from banished, where archetype == "Hieratic" and is_monster and is_face_up)
        resolve {
            send target to gy
        }
    }

    effect "Effect 4" {
        speed: 2
        mandatory
        trigger: custom "chain_end"
        target (1, card, you control, from gy, where archetype == "Hieratic")
        resolve {
            special_summon target
        }
    }
}
