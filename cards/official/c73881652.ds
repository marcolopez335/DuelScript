card "Zoodiac Combo" {
    id: 73881652
    type: Normal Trap

    effect "Effect 1" {
        speed: 2
        mandatory
        target (1, card, you control, from monster_zone, where is_face_up and is_xyz and archetype == "Zoodiac")
        resolve {
            attach (1, card, you control, from deck, where is_monster and archetype == "Zoodiac") to target as_material
        }
    }

    effect "Effect 2" {
        speed: 2
        cost {
            banish self
        }
        resolve {
            return (all, card, either controls) to deck
            draw 1
        }
    }
}
