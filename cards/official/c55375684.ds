card "Summon Cloud" {
    id: 55375684
    type: Continuous Spell

    effect "Effect 1" {
        speed: 1
        mandatory
        resolve {
            special_summon (1, card, either controls)
            destroy self
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: soft
        mandatory
        resolve {
            special_summon (1, card, either controls, from hand or gy)
            destroy self
        }
    }
}
