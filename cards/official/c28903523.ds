card "Eternal Sunshine" {
    id: 28903523
    type: Continuous Trap

    effect "Effect 1" {
        speed: 2
        mandatory
    }

    effect "Effect 3" {
        speed: 2
        once_per_turn: soft
        target (1, card, opponent controls, from monster_zone, where is_face_up)
        resolve {
            negate_effects target end_of_turn
            set_atk target (target.atk + 1) / 2 until end_of_turn
            set_def target (target.def + 1) / 2 until end_of_turn
        }
    }
}
