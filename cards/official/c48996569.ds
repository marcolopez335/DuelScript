    level: 7
    atk: 2500
    def: 2000

    summon {
        cannot_normal_summon
        fusion materials: "Elemental HERO Neos" + "Neo-Spacian Grand Mole"
    }

    effect "Effect 1" {
        speed: 1
        once_per_turn: soft
        mandatory
        target (1, card, opponent controls, from monster_zone)
        resolve {
            add_to_hand target
        }
    }

    effect "Effect 2" {
        speed: 1
        mandatory
        trigger: end_phase
        resolve {
            return self to deck
        }
    }

    effect "Effect 3" {
        speed: 1
        timing: when
        trigger: end_phase
        resolve {
            return self to deck
        }
    }
}
