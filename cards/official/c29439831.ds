card "Morgana the Witch of Eyes" {
    id: 29439831
    type: Effect Monster
    attribute: DARK
    race: Spellcaster
    level: 4
    atk: 1500
    def: 2100

    passive "Effect 5" {
        scope: self
        grant: cannot_be_destroyed by battle
    }

    effect "Effect 1" {
        speed: 2
        timing: when
        trigger: summoned
        cost {
            banish self
        }
        resolve {
            negate
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: summoned
        resolve {
            add_to_hand (1, card, you control, from deck, where archetype == "Morganite" and is_spell)
        }
    }

    effect "Effect 3" {
        speed: 1
        once_per_turn: hard
        timing: if
        trigger: summoned by special
        resolve {
            add_to_hand (1, card, you control, from deck, where archetype == "Morganite" and is_spell)
        }
    }

    effect "Effect 4" {
        speed: 1
        once_per_turn: soft
        mandatory
        resolve {
            set_atk (all, card, opponent controls, from monster_zone, where is_face_up and atk > 0) 0 until while_face_up
        }
    }
}
