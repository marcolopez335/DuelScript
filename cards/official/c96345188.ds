    race: Winged Beast
    level: 4
    atk: 1100
    def: 1900

    effect "Effect 1" {
        speed: 1
        once_per_turn: soft
        mandatory
        resolve {
            modify_level (all, card, you control, from monster_zone, where is_face_up and is_monster and not is_xyz and not is_link and archetype == "Raidraptor") + 1 until while_face_up
