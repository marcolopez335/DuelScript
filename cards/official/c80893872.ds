    type: Continuous Spell

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        mandatory
        resolve {
            add_to_hand (1, card, you control, from deck, where archetype == "Penguin" and not name == "Royal Penguins Garden")
        }
