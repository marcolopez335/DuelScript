card "Trance Archfiend" {
    id: 94283662
    type: Effect Monster
    attribute: DARK
    race: Fiend
    level: 4
    atk: 1500
    def: 500

    effect "Effect 1" {
        speed: 1
        once_per_turn: soft
        mandatory
        resolve {
            discard (1, card, you control, from hand, where race == Fiend)
            modify_atk self + 500 until end_of_turn
        }
    }

    effect "Effect 2" {
        speed: 1
        timing: when
        trigger: custom "chain_end"
        target (1, card, you control, from banished, where is_face_up and attribute == DARK)
        resolve {
            add_to_hand target
        }
    }
}
