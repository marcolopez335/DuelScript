card "Danger! Excitement! Mystery!" {
    id: 57433966
    type: Normal Spell

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        mandatory
        resolve {
            add_to_hand (1, card, you control, from deck, where archetype == "Danger" and is_monster and level <= 4)
            restrict you cannot_special_summon except (archetype == "Danger") end_of_turn
        }
    }
}
