card "Subterror Behemoth Fiendess" {
    id: 74937659
    type: Link Monster
    attribute: EARTH
    race: Wyrm
    link: 2
    link_arrows: [bottom_left, bottom_right]
    atk: 2000

    summon {
        cannot_normal_summon
        special_summon_procedure {
            from: extra_deck
            to: your_field
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: hard
        mandatory
        resolve {
            send (1, card, you control, from deck) to gy
            special_summon (1, card, you control, from hand) in face_down_defense
        }
    }

    effect "Effect 3" {
        speed: 1
        once_per_turn: soft
        mandatory
        trigger: custom "chain_active"
        resolve {
            add_to_hand (1, card, you control, from deck or gy)
        }
    }
}
