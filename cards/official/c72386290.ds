card "Focused Aquamirror" {
    id: 72386290
    type: Normal Spell

    effect "Effect 1" {
        speed: 1
        mandatory
        resolve {
            add_to_hand (1, card, you control, from deck, where archetype == "Gishki" and is_monster)
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: hard
        timing: when
        trigger: end_phase
        cost {
            banish self
        }
        resolve {
            set (1, card, you control, where (is_spell or is_trap) and archetype == "Aquamirror" and not name == "Focused Aquamirror")
        }
    }
}
