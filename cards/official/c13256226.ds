card "Elemental HERO Spirit of Neos" {
    id: 13256226
    type: Effect Monster
    attribute: LIGHT
    race: Warrior
    level: 7
    atk: 2500
    def: 2000

    summon {
        tributes: 2
    }

    effect "Effect 1" {
        speed: 1
        once_per_turn: soft
        timing: when
        trigger: summoned
        resolve {
            special_summon self in defense_position
            grant self cannot_be_destroyed by battle until while_face_up
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: soft
        timing: if
        trigger: summoned by special
        resolve {
            add_to_hand (1, card, you control, from deck)
        }
    }

    effect "Effect 3" {
        speed: 1
        once_per_turn: soft
        mandatory
        resolve {
            return self to deck shuffle
            special_summon (1, card, you control, from deck)
        }
    }
}
