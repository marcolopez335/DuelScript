card "Miracle Kids" {
    id: 55985014
    type: Normal Trap

    effect "Effect 1" {
        speed: 2
        mandatory
        target (1, card, opponent controls, from monster_zone, where is_face_up)
        resolve {
            modify_atk target - count((all, card, you control, from gy, where name == "Hero Kid")) * 400 until end_of_turn
        }
    }
}
