card "Beat, Bladesman Fur Hire" {
    id: 93850652
    type: Effect Monster
    attribute: EARTH
    race: Warrior
    level: 3
    atk: 1200
    def: 500

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        mandatory
        resolve {
            special_summon (1, card, you control, from hand, where archetype == "Fur Hire" and not name == "Beat, Bladesman Fur Hire")
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: soft
        timing: if
        trigger: summoned by special
        resolve {
            add_to_hand (1, card, you control, from deck, where archetype == "Fur Hire" and is_monster and not name == "Beat, Bladesman Fur Hire")
        }
    }
}
