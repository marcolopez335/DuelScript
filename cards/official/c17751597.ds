card "Branded Retribution" {
    id: 17751597
    type: Normal Trap

    effect "Effect 1" {
        speed: 2
        once_per_turn: hard
        mandatory
        trigger: opponent_activates [activate_spell, activate_trap, activate_spell]
        resolve {
            return (all, card, either controls) to deck
            negate
            destroy (all, card, either controls)
        }
    }

    effect "Effect 2" {
        speed: 2
        once_per_turn: hard
        cost {
            banish self
        }
        target (1, card, you control, from gy, where archetype == "Branded" and (is_spell or is_trap) and not name == "Branded Retribution")
        resolve {
            add_to_hand target
        }
    }
}
