card "Heroic Envoy" {
    id: 45337544
    type: Normal Spell

    effect "Effect 1" {
        speed: 1
        once_per_turn: hard
        mandatory
        resolve {
            add_to_hand (1, card, you control, from deck, where archetype == "Heroic" and is_monster)
        }
    }

    effect "Effect 2" {
        speed: 1
        once_per_turn: soft
        mandatory
        cost {
            banish self
        }
        target (1, card, you control, from gy, except self, where archetype == "Heroic")
        resolve {
            add_to_hand target
        }
    }
}
